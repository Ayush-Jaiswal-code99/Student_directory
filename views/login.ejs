<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Authentication Portal</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0b0c10;
            color: #f3f4f6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .login-container {
            background: #11131c;
            width: 100%;
            max-width: 400px;
            border-radius: 16px;
            border: 1px solid #1e2230;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            padding: 35px 25px;
        }

        .panel-heading {
            font-size: 1.3rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #d946ef; /* Neon Pink */
            font-weight: 700;
            margin-bottom: 5px;
            text-align: center;
        }

        .panel-subheading {
            font-size: 0.85rem;
            color: #6b7280;
            text-align: center;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .error-box {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
            padding: 10px;
            border-radius: 6px;
            font-size: 0.9rem;
            margin-bottom: 20px;
            text-align: center;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #3b82f6; /* Tech Blue */
            font-weight: 600;
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            background: #161925;
            border: 1px solid #222638;
            border-radius: 8px;
            padding: 12px 16px;
            color: #ffffff;
            font-size: 0.95rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: #d946ef;
            box-shadow: 0 0 10px rgba(217, 70, 239, 0.2);
        }

        .login-btn {
            width: 100%;
            background: #d946ef;
            color: #ffffff;
            border: none;
            padding: 14px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 15px rgba(217, 70, 239, 0.2);
        }

        .login-btn:hover {
            background: #c026d3;
            transform: translateY(-1px);
        }

        .back-link {
            text-align: center;
            display: block;
            text-decoration: none;
            color: #6b7280;
            font-size: 0.85rem;
            margin-top: 15px;
        }

        .back-link:hover {
            color: #ffffff;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <h5 class="panel-heading">Security Gate</h5>
        <p class="panel-subheading">Admin Authentication</p>

        <!-- Display error messages if login fails -->
        <% if (errorMessage) { %>
            <div class="error-box">
                <%= errorMessage %>
            </div>
        <% } %>

        <form action="/login" method="POST">
            
            <div class="form-group">
                <label for="email">Admin Email</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="admin@matrix.com" required>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
            </div>

            <button type="submit" class="login-btn">Authenticate →</button>
            
            <a href="/" class="back-link">Return to Home</a>
        </form>
    </div>

</body>
</html>
