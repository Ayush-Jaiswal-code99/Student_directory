<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System - Home</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { background-color: #0b0c10; color: #f3f4f6; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; position: relative; overflow-x: hidden; }
        body::before { content: ""; position: absolute; width: 300px; height: 300px; border-radius: 50%; filter: blur(120px); background: #d946ef; opacity: 0.12; top: 10%; left: 15%; }
        body::after { content: ""; position: absolute; width: 300px; height: 300px; border-radius: 50%; filter: blur(120px); background: #3b82f6; opacity: 0.12; bottom: 10%; right: 15%; }
        .home-container { width: 100%; max-width: 650px; padding: 40px; background: rgba(17, 19, 28, 0.7); border: 1px solid #1e2230; border-radius: 24px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4); backdrop-filter: blur(10px); text-align: center; }
        .welcome-badge { display: inline-flex; align-items: center; background: rgba(59, 130, 246, 0.1); color: #3b82f6; padding: 6px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; border: 1px solid rgba(59, 130, 246, 0.2); margin-bottom: 25px; }
        .main-title { font-size: 3rem; font-weight: 800; color: #ffffff; margin-bottom: 15px; }
        .highlight-text { background: linear-gradient(to right, #d946ef, #3b82f6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .description { font-size: 1.1rem; color: #9ca3af; margin-bottom: 35px; line-height: 1.6; }
        .action-block { display: flex; gap: 15px; justify-content: center; align-items: center; margin-bottom: 40px; }
        .cta-btn { text-decoration: none; color: #ffffff; background: #d946ef; padding: 14px 32px; border-radius: 12px; font-weight: 600; font-size: 1rem; transition: all 0.3s; box-shadow: 0 4px 15px rgba(217, 70, 239, 0.3); }
        .cta-btn:hover { background: #c026d3; transform: translateY(-2px); }
        .logout-btn { text-decoration: none; color: #ef4444; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); padding: 14px 24px; border-radius: 12px; font-weight: 600; font-size: 1rem; transition: all 0.3s; }
        .logout-btn:hover { background: #ef4444; color: white; }
        .stats-footer { padding-top: 25px; border-top: 1px solid #1e2230; display: flex; justify-content: space-around; }
        .stat-item { text-align: center; }
        .stat-number { font-size: 1.8rem; font-weight: 700; color: #10b981; }
        .stat-label { font-size: 0.75rem; color: #6b7280; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }
    </style>
</head>
<body>

    <div class="home-container">
        <span class="welcome-badge">
            <%= isLoggedIn ? "🔓 Secure Admin Mode" : "🔒 Public Portal Active" %>
        </span>

        <h1 class="main-title">Streamlined <br><span class="highlight-text">Student Matrix</span></h1>
        <p class="description">A secure cloud directory interface designed for managing, searching, and tracking batch records.</p>

        <div class="action-block">
            <a href="/student" class="cta-btn">Explore Directory →</a>
            <% if (isLoggedIn) { %>
                <a href="/logout" class="logout-btn">Log Out</a>
            <% } %>
        </div>

        <!-- 📊 REAL DASHBOARD LIVE STATS -->
        <div class="stats-footer">
            <div class="stat-item">
                <div class="stat-number"><%= total %></div>
                <div class="stat-label">Total Matrix</div>
            </div>
            <div class="stat-item">
                <div class="stat-number"><%= cse %></div>
                <div class="stat-label">CSE Enrolled</div>
            </div>
            <div class="stat-item">
                <div class="stat-number"><%= courses %></div>
                <div class="stat-label">Total Batches</div>
            </div>
        </div>
    </div>

</body>
</html>
