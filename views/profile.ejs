<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= student.name %> - Profile</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { background-color: #0b0c10; color: #f3f4f6; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
        .profile-container { background: #11131c; width: 100%; max-width: 500px; border-radius: 16px; border: 1px solid #1e2230; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5); overflow: hidden; text-align: center; padding: 35px 25px; }
        .top-heading { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 2px; color: #d946ef; font-weight: 700; margin-bottom: 25px; }
        .img-container { position: relative; display: inline-block; margin-bottom: 20px; }
        .profile-img { width: 140px; height: 140px; border-radius: 50%; object-fit: cover; border: 3px solid #3b82f6; }
        .status-dot { position: absolute; bottom: 8px; right: 8px; width: 14px; height: 14px; background-color: #10b981; border-radius: 50%; border: 2px solid #11131c; }
        .student-name { font-size: 1.8rem; color: #ffffff; font-weight: 700; margin-bottom: 12px; }
        .badge { display: inline-flex; align-items: center; background: rgba(16, 185, 129, 0.1); color: #10b981; padding: 6px 16px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; border: 1px solid rgba(16, 185, 129, 0.2); margin-bottom: 25px; }
        .details-box { background: #161925; border-radius: 12px; padding: 22px; text-align: left; margin-bottom: 25px; border: 1px solid #222638; }
        .detail-item { margin-bottom: 16px; font-size: 0.95rem; line-height: 1.6; color: #9ca3af; }
        .detail-item:last-child { margin-bottom: 0; }
        .detail-item strong { color: #4f46e5; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px; display: block; margin-bottom: 4px; }
        .detail-value { color: #e5e7eb; }
        
        .btn-stack { display: flex; flex-direction: column; gap: 10px; width: 100%; }
        .action-btn { display: block; text-align: center; text-decoration: none; color: #ffffff; padding: 12px; border-radius: 8px; font-weight: 600; font-size: 0.9rem; width: 100%; transition: 0.2s; cursor: pointer; }
        .edit-btn { background: #3b82f6; border: none; }
        .edit-btn:hover { background: #2563eb; }
        .delete-btn { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }
        .delete-btn:hover { background: #ef4444; color: white; }
        .back-btn { background: #1f2235; border: 1px solid #313752; }
        .back-btn:hover { background: #2a2e45; }
    </style>
</head>
<body>

    <div class="profile-container">
        <h5 class="top-heading">Student Profile</h5>

        <div class="img-container">
            <img class="profile-img" src="/images/<%= student.rollNumber %>.jpg" onerror="this.src='https://unsplash.com'">
            <div class="status-dot"></div>
        </div>

        <h1 class="student-name"><%= student.name %></h1>
        <span class="badge">⚙️ <%= student.course %></span>

        <div class="details-box">
            <div class="detail-item">
                <strong>ID Parameter</strong>
                <span class="detail-value">#<%= student.rollNumber %></span>
            </div>
            <div class="detail-item">
                <strong>Enrolled Course</strong>
                <span class="detail-value"><%= student.course %></span>
            </div>
            <div class="detail-item">
                <strong>Profile Description</strong>
                <span class="detail-value"><%= student.descr %></span>
            </div>
        </div>

        <!-- OPERATIONS CONTROL STACK -->
        <div class="btn-stack">
            <!-- ✏️ EDIT ACTION (Protected by session layout in backend) -->
            <a href="/student/<%= student.rollNumber %>/edit" class="action-btn edit-btn">✏️ Edit Profile Data</a>
            
            <!-- 🗑️ DELETE FORM -->
            <form action="/student/<%= student.rollNumber %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this student profile?');">
                <button type="submit" class="action-btn delete-btn">💥 Purge From Directory</button>
            </form>

            <a href="/student" class="action-btn back-btn">← Return to Directory</a>
        </div>
    </div>

</body>
</html>
