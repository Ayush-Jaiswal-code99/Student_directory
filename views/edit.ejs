<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student - Profile Editor</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
        body { background-color: #0b0c10; color: #f3f4f6; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
        .admin-container { background: #11131c; width: 100%; max-width: 500px; border-radius: 16px; border: 1px solid #1e2230; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5); padding: 35px 25px; }
        .panel-heading { font-size: 1.3rem; text-transform: uppercase; letter-spacing: 2px; color: #3b82f6; font-weight: 700; margin-bottom: 5px; text-align: center; }
        .panel-subheading { font-size: 0.85rem; color: #6b7280; text-align: center; margin-bottom: 30px; text-transform: uppercase; letter-spacing: 1px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; color: #d946ef; font-weight: 600; margin-bottom: 8px; }
        .form-control { width: 100%; background: #161925; border: 1px solid #222638; border-radius: 8px; padding: 12px 16px; color: #ffffff; font-size: 0.95rem; outline: none; transition: all 0.3s ease; }
        .form-control:focus { border-color: #3b82f6; box-shadow: 0 0 10px rgba(59, 130, 246, 0.2); }
        textarea.form-control { resize: none; height: 100px; }
        .btn-container { display: flex; flex-direction: column; gap: 12px; margin-top: 10px; }
        .submit-btn { width: 100%; background: #3b82f6; color: #ffffff; border: none; padding: 14px; border-radius: 8px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 4px 15px rgba(59, 130, 246, 0.2); }
        .submit-btn:hover { background: #2563eb; transform: translateY(-1px); }
        .back-link { text-align: center; display: block; text-decoration: none; color: #9ca3af; font-size: 0.9rem; padding: 10px; }
        .back-link:hover { color: #ffffff; }
    </style>
</head>
<body>

    <div class="admin-container">
        <h5 class="panel-heading">Editor Terminal</h5>
        <p class="panel-subheading">Modify Record for Roll No: <%= student.rollNumber %></p>
        <!-- फॉर्म एक्शन बदलें -->
        <form action="/student/<%= student.rollNumber %>/edit" method="POST">

            <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" name="name" class="form-control" value="<%= student.name %>" required>
            </div>

            <div class="form-group">
                <label for="course">Enrolled Course</label>
                <input type="text" id="course" name="course" class="form-control" value="<%= student.course %>" required>
            </div>

            <div class="form-group">
                <label for="descr">Profile Description</label>
                <textarea id="descr" name="descr" class="form-control"><%= student.descr %></textarea>
            </div>

            <div class="btn-container">
                <button type="submit" class="submit-btn">✓ Save Matrix Changes</button>
                <a href="/student/<%= student.rollNumber %>" class="back-link">Cancel & Dismiss</a>
            </div>

        </form>
    </div>

</body>
</html>
